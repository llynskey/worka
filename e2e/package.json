{
  "name": "worku-e2e",
  "private": true,
  "description": "Playwright end-to-end tests: boots Postgres (docker) + the .NET API (dotnet run) + the Expo web app and drives real user journeys in a browser.",
  "scripts": {
    "db:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test": "npm run db:up && playwright test",
    "test:headed": "npm run db:up && playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
